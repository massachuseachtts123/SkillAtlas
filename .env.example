# All optional - app degrades gracefully without any of them.

# GitHub PAT: raises rate limit 60/hr -> 5000/hr (recommended for demos)
GITHUB_TOKEN=

# Gemini (single LLM provider - free tier works).
# Powers AI skill extraction + AI career summary. No key -> both features
# degrade gracefully; all deterministic scores are unaffected.
GEMINI_API_KEY=

# Supabase persistence (optional - demo works without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
