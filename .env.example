# All optional - app degrades gracefully without them.

# Gemini (single LLM provider - free tier works).
# Powers AI career/specialization insights. No key -> "AI insights unavailable"
# and the app keeps working: all evidence, alignment, and graph logic are
# deterministic and unaffected.
GEMINI_API_KEY=

# Supabase persistence (optional - demo works without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
